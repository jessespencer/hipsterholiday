---
// Fixed top navigation, the same on every page: the brand goes home, then this
// year's invite, the archive, and RSVP. A small underline marks where you are.
// Transparent over the hero, solid once you scroll.
import { event } from '../data/event';

const invite = `/${event.year}/`;
const path = Astro.url.pathname;
const onInvite = path.startsWith(invite) || path === invite.slice(0, -1);
const onHome = path === '/';
const shortYear = `’${String(event.year).slice(-2)}`;
---
<header class="topnav" data-topnav>
    <a href="/" class="brand" aria-label="Hipster Holiday: home"><span class="brand-full">Hipster Holiday</span><span class="brand-short" aria-hidden="true">HH</span></a>
    <nav class="links" aria-label="Site">
        <a href={invite} class="link this-year" aria-current={onInvite ? 'page' : undefined} aria-label={`This year: ${event.year}`}>
            <span class="this-label">This Year</span>
            <span class="yr" aria-hidden="true">{shortYear}</span>
            <span class="yr-full" aria-hidden="true">{event.year}</span>
        </a>
        <span class="divider" aria-hidden="true"></span>
        <a href="/#archive" class="link" data-archive-link={onHome ? '' : undefined}>Archive</a>
        <a href={`${invite}#rsvp`} class="link link-cta">RSVP</a>
    </nav>
</header>

<script>
    const nav = document.querySelector<HTMLElement>('[data-topnav]');
    if (nav) {
        const update = () => nav.classList.toggle('is-scrolled', window.scrollY > 24);
        window.addEventListener('scroll', update, { passive: true });
        update();
    }

    // On home, "Archive" is marked while the archive is on screen
    const archiveLink = document.querySelector<HTMLElement>('[data-archive-link]');
    const archive = document.getElementById('archive');
    if (archiveLink && archive) {
        new IntersectionObserver(([entry]) => {
            archiveLink.classList.toggle('is-here', entry.isIntersecting);
        }, { rootMargin: '-45% 0px -45% 0px' }).observe(archive);
    }
</script>

<style>
    /* Fallbacks keep the nav intact on pages that don't use the Base layout (2025) */
    .topnav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        height: var(--nav-h, 64px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 0 clamp(16px, 4vw, 48px);
        border-bottom: 1px solid transparent;
        transition: background 0.35s ease, border-color 0.35s ease, backdrop-filter 0.35s ease;
    }

    .topnav.is-scrolled {
        background: rgba(10, 8, 6, 0.78);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom-color: color-mix(in srgb, var(--gold, #d4a853) 12%, transparent);
    }

    .brand {
        font-family: var(--font-theme, 'Fraunces', Georgia, serif);
        font-weight: 700;
        font-variation-settings: 'SOFT' 100, 'opsz' 24;
        font-size: 18px;
        letter-spacing: -0.01em;
        color: var(--text-primary, #ede4d4);
        text-decoration: none;
        white-space: nowrap;
    }

    .links {
        display: flex;
        align-items: center;
        gap: clamp(14px, 2.4vw, 32px);
    }

    .link {
        position: relative;
        font-family: var(--font-body, 'Outfit', -apple-system, sans-serif);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: var(--text-mid, rgba(237, 228, 212, 0.6));
        text-decoration: none;
        transition: color 0.25s ease;
    }

    .link:hover,
    .link:focus-visible,
    .link[aria-current='page'],
    .link.is-here {
        color: var(--text-primary, #ede4d4);
    }

    /* You are here: a short accent underline (letter-spacing leaves a trailing gap, so trim it) */
    .link:not(.link-cta)::after {
        content: '';
        position: absolute;
        left: 0;
        right: 2.5px;
        bottom: -7px;
        height: 1.5px;
        border-radius: 1px;
        background: var(--gold, #d4a853);
        transform: scaleX(0);
        transition: transform 0.3s ease;
    }

    .link[aria-current='page']::after,
    .link.is-here::after {
        transform: scaleX(1);
    }

    /* This year's party: the label and the year as a small accent badge,
       centred on one line and sized to the label's capitals */
    .this-year {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

    .this-year > * {
        line-height: 1;
        text-box: trim-both cap alphabetic;
    }

    /* Letter-spacing trails the last letter; trim it so both gaps match */
    .this-label {
        margin-right: -2.5px;
    }

    .yr-full,
    .brand-short {
        display: none;
    }

    .yr {
        font-family: var(--font-theme, 'Fraunces', Georgia, serif);
        font-style: italic;
        font-weight: 700;
        font-variation-settings: 'SOFT' 100, 'opsz' 14;
        font-size: 12px;
        letter-spacing: 0.02em;
        text-transform: none;
        color: var(--gold, #d4a853);
    }

    /* Keeps this year apart from the archive */
    .divider {
        width: 1px;
        height: 14px;
        background: color-mix(in srgb, var(--text-primary, #ede4d4) 22%, transparent);
    }

    .link-cta {
        padding: 9px 18px;
        border-radius: 100px;
        background: var(--gold, #d4a853);
        color: var(--on-gold, #1a120b);
        font-weight: 600;
        transition: background 0.25s ease, transform 0.25s ease;
    }

    .link-cta:hover,
    .link-cta:focus-visible {
        background: var(--gold-hover, #e2bb6c);
        color: var(--on-gold, #1a120b);
    }

    @media (max-width: 480px) {
        .brand {
            font-size: 15px;
        }

        .link {
            font-size: 10px;
            letter-spacing: 1.8px;
        }

        .link:not(.link-cta)::after {
            right: 1.8px;
        }

        .link-cta {
            padding: 8px 13px;
        }

        .links {
            gap: 12px;
        }

        /* Phones: "This Year '26" becomes just the year */
        .this-label,
        .yr {
            display: none;
        }

        .yr-full {
            display: inline;
            font-family: var(--font-theme, 'Fraunces', Georgia, serif);
            font-style: italic;
            font-weight: 700;
            font-variation-settings: 'SOFT' 100, 'opsz' 24;
            font-size: 14px;
            letter-spacing: 0.01em;
            color: var(--text-primary, #ede4d4);
        }

        .this-year {
            gap: 6px;
        }
    }

    /* The smallest phones: the brand shrinks to a monogram */
    @media (max-width: 370px) {
        .brand-full {
            display: none;
        }

        .brand-short {
            display: inline;
        }
    }
</style>
