---
// Fixed top navigation: transparent over the hero, solid once you scroll.
const links = [
    { href: '#details', label: 'Details' },
    { href: '#archive', label: 'Archive' },
];
---
<header class="topnav" data-topnav>
    <a href="#countdown-hero" class="brand">Hipster Holiday</a>
    <nav class="links" aria-label="Sections">
        {links.map((link) => (
            <a href={link.href} class="link">{link.label}</a>
        ))}
        <a href="#rsvp" class="link link-cta">RSVP</a>
    </nav>
</header>

<script>
    const nav = document.querySelector<HTMLElement>('[data-topnav]');
    if (nav) {
        const update = () => nav.classList.toggle('is-scrolled', window.scrollY > 24);
        window.addEventListener('scroll', update, { passive: true });
        update();
    }
</script>

<style>
    .topnav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        height: var(--nav-h);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 0 clamp(16px, 4vw, 48px);
        border-bottom: 1px solid transparent;
        transition: background 0.35s ease, border-color 0.35s ease, backdrop-filter 0.35s ease;
    }

    .topnav.is-scrolled {
        background: rgba(10, 8, 6, 0.78);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom-color: rgba(212, 168, 83, 0.12);
    }

    .brand {
        font-family: var(--font-theme);
        font-weight: 700;
        font-variation-settings: 'SOFT' 100, 'opsz' 24;
        font-size: 18px;
        letter-spacing: -0.01em;
        color: var(--text-primary);
        text-decoration: none;
        white-space: nowrap;
    }

    .links {
        display: flex;
        align-items: center;
        gap: clamp(14px, 2.4vw, 32px);
    }

    .link {
        font-family: var(--font-body);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: var(--text-mid);
        text-decoration: none;
        transition: color 0.25s ease;
    }

    .link:hover,
    .link:focus-visible {
        color: var(--text-primary);
    }

    .link-cta {
        padding: 9px 18px;
        border-radius: 100px;
        background: var(--gold);
        color: #1a120b;
        font-weight: 600;
        transition: background 0.25s ease, transform 0.25s ease;
    }

    .link-cta:hover,
    .link-cta:focus-visible {
        background: #e2bb6c;
        color: #1a120b;
    }

    @media (max-width: 480px) {
        .brand {
            font-size: 15px;
        }

        .link {
            font-size: 10px;
            letter-spacing: 1.8px;
        }

        .link-cta {
            padding: 8px 14px;
        }
    }
</style>
