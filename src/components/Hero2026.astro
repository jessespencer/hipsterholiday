---
// 2026 theme: "'Twas the night before Christmas, the parents half crazy, not a creature was stirring… except for the baby."
// The bedroom sits in the dark; a nightlight follows the pointer (or plays a
// short tour on its own) and the sleepers puff out z's. Lighting up the baby
// wakes the scene: she gets her own spotlight, wide-awake marks and sparkles,
// and the punchline appears.
import CountdownTimer from './CountdownTimer.astro';
---
<section class="hero26" id="countdown-hero" data-hero26>
    <p class="poem">
        <span>’Twas the night before Christmas, the parents half crazy,</span>
        <span>not a creature was stirring…</span>
    </p>

    <div class="scene" data-scene>
        <img
            class="scene-img"
            src="/2026/assets/bedroom.jpg"
            alt="The family asleep in a pile on the bed, with the new baby wide awake in front of them"
            width="2000"
            height="2000"
            data-scene-img
        />
        <div class="night" aria-hidden="true"></div>
        <div class="baby-glow" aria-hidden="true"></div>
        <div class="fx-layer" aria-hidden="true" data-fx></div>
        <svg class="awake" viewBox="-200 -200 400 400" aria-hidden="true" data-awake>
            <g class="awake-lines">
                <path d="M -118 -96 L -150 -128" />
                <path d="M -62 -138 L -78 -182" />
                <path d="M 4 -150 L 4 -196" />
                <path d="M 68 -136 L 86 -178" />
                <path d="M 120 -94 L 154 -122" />
            </g>
        </svg>
    </div>

    <p class="punch">…except for the baby.</p>

    <div class="details">
        <h1 class="title">
            <span class="title-kicker">The Spencer Family’s</span>
            Hipster Holiday <span class="title-year">2026</span>
        </h1>
        <span class="rule" aria-hidden="true"></span>
        <div class="timer">
            <CountdownTimer />
        </div>
        <a href="#details" class="invite-cue">
            View the invite
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 2v11M3.5 8.5 8 13l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/hipster-holiday.ics" class="invite-cue calendar-cue">
            Add to calendar
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="2.5" y="3.5" width="11" height="10" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M2.5 6.5h11M5.5 2v3M10.5 2v3M8 8.5v3.5M6.25 10.25h3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        </a>
    </div>

</section>

<script>
    // Points in the source photo (2000 × 2000)
    const IMG_SIZE = 2000;
    const SLEEPERS = [
        { x: 1080, y: 470 },
        { x: 1300, y: 590 },
        { x: 1600, y: 790 },
        { x: 1840, y: 930 },
    ];
    const BABY_HEAD = { x: 1311, y: 1229 };
    const BED_CENTER = { x: 985, y: 1000 };
    const BABY_BODY = { x: 1000, y: 1270, rx: 520, ry: 290 };
    const FIND_RADIUS = 260;
    // Three stops: the kids, the parents, then the baby (each pair shares one pool of light)
    const TOUR = [
        { x: 1120, y: 600 },
        { x: 1650, y: 935 },
        BABY_HEAD,
    ];

    const hero = document.querySelector<HTMLElement>('[data-hero26]');
    const scene = document.querySelector<HTMLElement>('[data-scene]');
    const img = document.querySelector<HTMLImageElement>('[data-scene-img]');
    const fx = document.querySelector<HTMLElement>('[data-fx]');
    const awake = document.querySelector<SVGElement>('[data-awake]');

    if (hero && scene && img && fx && awake) {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Map photo coordinates to scene pixels, honouring object-fit: cover + object-position
        let map = { scale: 1, ox: 0, oy: 0 };
        const toScene = (p: { x: number; y: number }) => ({ x: map.ox + p.x * map.scale, y: map.oy + p.y * map.scale });

        function measure() {
            const w = scene!.clientWidth;
            const h = scene!.clientHeight;
            const scale = Math.max(w / IMG_SIZE, h / IMG_SIZE);
            const [px, py] = getComputedStyle(img!).objectPosition.split(' ').map((v) => parseFloat(v) / 100);
            map = { scale, ox: (w - IMG_SIZE * scale) * px, oy: (h - IMG_SIZE * scale) * py };

            // Pin the baby's spotlight and awake marks to her
            const body = toScene(BABY_BODY);
            const head = toScene(BABY_HEAD);
            scene!.style.setProperty('--bx', `${body.x}px`);
            scene!.style.setProperty('--by', `${body.y}px`);
            scene!.style.setProperty('--brx', `${BABY_BODY.rx * scale}px`);
            scene!.style.setProperty('--bry', `${BABY_BODY.ry * scale}px`);
            awake!.style.left = `${head.x}px`;
            awake!.style.top = `${head.y}px`;
            awake!.style.width = `${400 * scale}px`;

            // Centre the verse and punchline on the middle of the bed, not on their column
            const verse = hero!.querySelector<HTMLElement>('.poem');
            if (verse) {
                const bedX = scene!.getBoundingClientRect().left + toScene(BED_CENTER).x;
                const col = verse.getBoundingClientRect();
                hero!.style.setProperty('--cx', `${(bedX - col.left).toFixed(1)}px`);
            }
        }

        const setLight = (x: number, y: number) => {
            scene!.style.setProperty('--lx', `${x.toFixed(1)}px`);
            scene!.style.setProperty('--ly', `${y.toFixed(1)}px`);
        };

        function spawn(cls: string, text: string, p: { x: number; y: number }, size: number) {
            const el = document.createElement('span');
            el.className = cls;
            el.textContent = text;
            el.style.left = `${p.x}px`;
            el.style.top = `${p.y}px`;
            el.style.setProperty('--size', `${size}px`);
            el.style.setProperty('--dx', `${(Math.random() - 0.3) * 2.4}em`);
            el.addEventListener('animationend', () => el.remove());
            fx!.appendChild(el);
        }

        let found = false;
        let lockUntil = 0;
        function wake() {
            if (found) return;
            found = true;
            lockUntil = performance.now() + 1600;
            hero!.classList.add('is-found');
        }

        // Re-measure whenever the scene's size actually changes. Safari runs this script
        // before layout settles, so a one-off measurement can be badly stale.
        measure();
        new ResizeObserver(() => measure()).observe(scene);
        window.addEventListener('resize', measure);
        document.fonts?.ready.then(measure);

        {
            const start = toScene(TOUR[0]);
            const cur = { ...start };
            const target = { ...start };
            // The intro tour always plays to the baby; only then does the pointer take over
            let introDone = false;
            let userDriving = false;
            let tourStep = 0;
            let tourTimer = 0;

            // With Reduce Motion the light doesn't glide: it dims, reappears at the
            // next stop, and is already stretched over the baby when it lands on her.
            const FADE_MS = 600;
            function advanceTour() {
                if (userDriving || tourStep >= TOUR.length - 1) return;
                if (!reduceMotion) {
                    tourStep++;
                    tourTimer = window.setTimeout(advanceTour, 1800);
                    return;
                }
                hero!.classList.remove('is-lit');
                tourTimer = window.setTimeout(() => {
                    if (userDriving) return;
                    tourStep++;
                    const p = toScene(TOUR[tourStep]);
                    cur.x = target.x = p.x;
                    cur.y = target.y = p.y;
                    if (tourStep === TOUR.length - 1) wake();
                    hero!.classList.add('is-lit');
                    tourTimer = window.setTimeout(advanceTour, 1800 + FADE_MS);
                }, FADE_MS);
            }
            setLight(start.x, start.y);
            // The first line plays alone; the light comes on with "not a creature was stirring…"
            // (keep in step with the second line's animation-delay in the styles)
            window.setTimeout(() => hero!.classList.add('is-lit'), 1600);
            tourTimer = window.setTimeout(advanceTour, 3200);

            function onPoint(e: PointerEvent) {
                if (!introDone) {
                    // A resting mouse shouldn't cut the tour short, but a deliberate
                    // touch, tap, or click-drag takes the light straight away.
                    const hovering = e.type === 'pointermove' && e.pointerType === 'mouse' && e.buttons === 0;
                    if (hovering) return;
                    introDone = true;
                    hero!.classList.add('is-ready');
                }
                const r = scene!.getBoundingClientRect();
                target.x = e.clientX - r.left;
                target.y = e.clientY - r.top;
                if (!userDriving) {
                    // Handoff: the baby keeps her spotlight exactly as it is (her own layer
                    // matches the stretched light), and a fresh light switches on at the cursor.
                    userDriving = true;
                    morph = 0;
                    cur.x = target.x;
                    cur.y = target.y;
                    hero!.style.transition = 'none';
                    hero!.classList.remove('is-lit');
                    hero!.classList.add('is-driving');
                    void hero!.offsetWidth;
                    hero!.style.transition = '';
                    requestAnimationFrame(() => hero!.classList.add('is-lit'));
                }
            }
            hero.addEventListener('pointermove', onPoint);
            hero.addEventListener('pointerdown', onPoint);

            let visible = true;
            let raf = 0;
            let last = 0;
            // 0 = round nightlight, 1 = stretched over the baby's whole body.
            // After the tour the light itself becomes her spotlight; when the
            // visitor takes the light, it shrinks back and her own spotlight holds.
            let morph = 0;
            function frame(now: number) {
                // Ease toward the target at the same speed regardless of frame rate
                const dt = last ? Math.min(now - last, 100) : 16.7;
                last = now;
                // The tour glides slowly; once the visitor has the light it follows them briskly
                const ease = 1 - Math.pow(1 - (userDriving ? 0.09 : 0.055), dt / 16.7);

                // Tour stops are re-mapped each frame so a resize mid-tour stays on target.
                // Right after waking, the light holds on the baby for a beat.
                const head = toScene(BABY_HEAD);
                if (found && now < lockUntil) {
                    target.x = head.x;
                    target.y = head.y;
                } else if (!userDriving) {
                    const p = toScene(TOUR[tourStep]);
                    target.x = p.x;
                    target.y = p.y;
                }
                if (found && !introDone && now >= lockUntil) {
                    introDone = true;
                    hero!.classList.add('is-ready');
                }
                // While the light is still off it just sits on the first stop, so a stale
                // starting point never sweeps across the room
                if (!userDriving && !hero!.classList.contains('is-lit')) {
                    cur.x = target.x;
                    cur.y = target.y;
                }
                cur.x += (target.x - cur.x) * ease;
                cur.y += (target.y - cur.y) * ease;

                const morphTarget = found && !userDriving ? 1 : 0;
                morph = reduceMotion ? morphTarget : morph + (morphTarget - morph) * (1 - Math.pow(1 - 0.05, dt / 16.7));
                const body = toScene(BABY_BODY);
                setLight(cur.x + (body.x - cur.x) * morph, cur.y + (body.y - cur.y) * morph);
                scene!.style.setProperty('--m', morph.toFixed(3));

                // Only the tour's final stop (or the visitor) can find her; passing by doesn't count
                const searching = userDriving || tourStep === TOUR.length - 1;
                if (searching && Math.hypot(cur.x - head.x, cur.y - head.y) < Math.max(FIND_RADIUS * map.scale, 60)) wake();
                if (visible) raf = requestAnimationFrame(frame);
            }

            // Sleepers breathe out z's; once she's found, the baby gives off sparkles
            let tick = 0;
            let fxTimer = 0;
            function puff() {
                const sleeper = toScene(SLEEPERS[tick % SLEEPERS.length]);
                spawn('zzz', 'z', sleeper, Math.max(16, 70 * map.scale));
                if (found && tick % 2 === 0) {
                    const head = toScene(BABY_HEAD);
                    const a = -Math.PI / 2 + (Math.random() - 0.5) * 2.2;
                    const r = 170 * map.scale;
                    spawn('spark', '✦', { x: head.x + Math.cos(a) * r, y: head.y + Math.sin(a) * r }, Math.max(12, 44 * map.scale));
                }
                tick++;
            }

            const io = new IntersectionObserver(([entry]) => {
                visible = entry.isIntersecting;
                cancelAnimationFrame(raf);
                window.clearInterval(fxTimer);
                if (visible) {
                    last = 0;
                    raf = requestAnimationFrame(frame);
                    // Drifting z's and sparkles are pure motion, so Reduce Motion skips them
                    if (!reduceMotion) fxTimer = window.setInterval(puff, 650);
                }
            });
            io.observe(hero);
        }
    }
</script>

<style>
    /* Lets the baby's spotlight fade in smoothly */
    /* Lets the nightlight switch on gradually instead of appearing at full size */
    @property --light-on {
        syntax: '<number>';
        inherits: true;
        initial-value: 0;
    }

    @property --baby-on {
        syntax: '<number>';
        inherits: true;
        initial-value: 0;
    }

    .hero26 {
        --night: rgba(6, 4, 2, 0.9);
        --light-size: clamp(130px, 24vmin, 300px);
        --bleed: clamp(80px, 14vw, 260px);
        --light-on: 0;
        --light-r: max(1px, calc(var(--light-size) * var(--light-on)));
        transition: --light-on 1.3s cubic-bezier(0.22, 1, 0.36, 1);
        --cream: #ede4d4;
        --verse: rgba(237, 228, 212, 0.72);

        position: relative;
        z-index: 1;
        min-height: 100vh;
        min-height: 100svh;
        display: grid;
        grid-template-columns: minmax(0, 1fr) min(100svh, 56vw) clamp(16px, 3vw, 48px);
        grid-template-rows: 1fr auto 1fr;
        grid-template-areas:
            ". scene ."
            "details scene ."
            ". scene .";
        overflow: hidden;
        background: var(--bg-deep);
        touch-action: pan-y;
    }

    /* ---------- the scene ---------- */

    .scene {
        grid-area: scene;
        position: relative;
        overflow: hidden;
        /* Dragging on the picture moves the light; the rest of the page still scrolls */
        touch-action: none;
        /* Reach under the title column so the room fades into it rather than stopping at a seam */
        margin-left: calc(-1 * var(--bleed));
        -webkit-mask-image: linear-gradient(to right, transparent 0, rgba(0, 0, 0, 0.25) 14%, rgba(0, 0, 0, 0.7) 28%, #000 40%, #000 93%, transparent 100%);
                mask-image: linear-gradient(to right, transparent 0, rgba(0, 0, 0, 0.25) 14%, rgba(0, 0, 0, 0.7) 28%, #000 40%, #000 93%, transparent 100%);
        --lx: 50%;
        --ly: 20%;
        --bx: 50%;
        --by: 65%;
        --brx: 200px;
        --bry: 110px;
        --baby-on: 0;
        --m: 0;
        /* No fade: her layer is identical to the light it replaces, so the swap is invisible */
        transition: none;
    }

    /* Her own spotlight only takes over once the visitor moves the light away */
    .is-driving .scene {
        --baby-on: 1;
    }

    /* The cursor's light switches on quicker than the opening one */
    .is-driving {
        transition-duration: 0.45s;
    }

    .is-lit {
        --light-on: 1;
    }

    .scene-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 62% 50%;
        user-select: none;
        -webkit-user-drag: none;
    }

    /* Darkness with two holes: the moving nightlight, and (once found) a spotlight on the baby */
    /* The nightlight's radii, blending from a circle to the baby's body ellipse */
    .night,
    .baby-glow {
        --lrx: calc(var(--light-r) * (1 - var(--m)) + var(--brx) * var(--m));
        --lry: calc(var(--light-r) * (1 - var(--m)) + var(--bry) * var(--m));
    }

    .night {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            radial-gradient(ellipse var(--lrx) var(--lry) at var(--lx) var(--ly), rgba(255, 196, 120, 0.22), transparent 70%),
            radial-gradient(ellipse var(--brx) var(--bry) at var(--bx) var(--by), rgba(255, 196, 120, calc(0.22 * var(--baby-on))), transparent 70%),
            var(--night);
        -webkit-mask-image:
            radial-gradient(ellipse var(--lrx) var(--lry) at var(--lx) var(--ly), rgba(0, 0, 0, 0.05) 0, rgba(0, 0, 0, 0.3) 45%, #000 100%),
            radial-gradient(ellipse var(--brx) var(--bry) at var(--bx) var(--by),
                rgba(0, 0, 0, calc(1 - var(--baby-on) * 0.95)) 0,
                rgba(0, 0, 0, calc(1 - var(--baby-on) * 0.7)) 45%,
                #000 100%);
        -webkit-mask-composite: source-in;
                mask-image:
            radial-gradient(ellipse var(--lrx) var(--lry) at var(--lx) var(--ly), rgba(0, 0, 0, 0.05) 0, rgba(0, 0, 0, 0.3) 45%, #000 100%),
            radial-gradient(ellipse var(--brx) var(--bry) at var(--bx) var(--by),
                rgba(0, 0, 0, calc(1 - var(--baby-on) * 0.95)) 0,
                rgba(0, 0, 0, calc(1 - var(--baby-on) * 0.7)) 45%,
                #000 100%);
                mask-composite: intersect;
    }

    /* Warm stage light that settles on the baby */
    .baby-glow {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(ellipse calc(var(--brx) * 1.1) calc(var(--bry) * 1.2) at var(--bx) var(--by),
            rgba(255, 200, 130, 0.22), transparent 70%);
        mix-blend-mode: screen;
        opacity: max(var(--baby-on), var(--m));
    }

    .fx-layer {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .fx-layer :global(.zzz),
    .fx-layer :global(.spark) {
        position: absolute;
        font-family: var(--font-theme);
        font-size: var(--size, 28px);
        line-height: 1;
        opacity: 0;
        transform: translate(-50%, -50%);
    }

    .fx-layer :global(.zzz) {
        font-style: italic;
        font-weight: 600;
        color: var(--cream);
        text-shadow: 0 0 12px rgba(255, 200, 130, 0.5);
        animation: drift 3.2s ease-out forwards;
    }

    .fx-layer :global(.spark) {
        color: var(--gold);
        text-shadow: 0 0 10px rgba(212, 168, 83, 0.8);
        animation: twinkle 1.6s ease-out forwards;
    }

    @keyframes drift {
        0%   { opacity: 0;   transform: translate(-50%, -50%) scale(0.6); }
        15%  { opacity: 0.9; }
        100% { opacity: 0;   transform: translate(calc(-50% + 1.4em), calc(-50% - 3.2em)) scale(1.25) rotate(-12deg); }
    }

    @keyframes twinkle {
        0%   { opacity: 0; transform: translate(-50%, -50%) scale(0.2) rotate(0deg); }
        30%  { opacity: 1; transform: translate(-50%, -50%) scale(1.1) rotate(25deg); }
        100% { opacity: 0; transform: translate(calc(-50% + var(--dx, 0em)), calc(-50% - 1.6em)) scale(0.6) rotate(70deg); }
    }

    /* "Wide awake" marks that draw in around her head */
    .awake {
        position: absolute;
        width: 160px;
        height: auto;
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        overflow: visible;
        pointer-events: none;
    }

    .awake-lines path {
        fill: none;
        stroke: var(--gold);
        stroke-width: 12;
        stroke-linecap: round;
        stroke-dasharray: 60;
        stroke-dashoffset: 60;
        filter: drop-shadow(0 0 6px rgba(212, 168, 83, 0.7));
    }

    .is-found .awake-lines path {
        animation: draw 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards, jitter 1.8s ease-in-out 1.2s infinite;
    }

    .is-found .awake-lines path:nth-child(2) { animation-delay: 0.08s, 1.28s; }
    .is-found .awake-lines path:nth-child(3) { animation-delay: 0.16s, 1.36s; }
    .is-found .awake-lines path:nth-child(4) { animation-delay: 0.24s, 1.44s; }
    .is-found .awake-lines path:nth-child(5) { animation-delay: 0.32s, 1.52s; }

    .is-found .awake-lines {
        animation: pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s both;
        transform-origin: 0 0;
    }

    @keyframes draw {
        to { stroke-dashoffset: 0; }
    }

    @keyframes jitter {
        0%, 100% { opacity: 1; }
        50%      { opacity: 0.45; }
    }

    @keyframes pop {
        from { transform: scale(0.85); }
        to   { transform: scale(1); }
    }



    /* ---------- the words: one voice ----------
       Fraunces italic carries the verse (cream, then gold for the punchline),
       Fraunces bold carries the name, and the numbers use the same face. */

    .details {
        padding-left: clamp(32px, 7vw, 120px);
        padding-right: 40px;
    }

    .poem,
    .punch {
        font-family: var(--font-theme);
        font-style: italic;
        font-weight: 400;
        font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 72;
        font-size: clamp(19px, 1.75vw, 28px);
        line-height: 1.35;
        letter-spacing: 0.005em;
    }

    /* The story reads down the scene: setup across the top, payoff under the baby */
    .poem,
    .punch {
        grid-area: scene;
        position: relative;
        z-index: 2;
        justify-self: stretch;
        margin: 0;
        /* --cx (set by the script) is the bed's centre within this column */
        padding-left: max(0px, calc(2 * var(--cx, 50%) - 100%));
        padding-right: max(0px, calc(100% - 2 * var(--cx, 50%)));
        text-align: center;
        pointer-events: none;
        text-shadow: 0 2px 14px rgba(0, 0, 0, 0.7);
    }

    .poem {
        align-self: start;
        padding-top: calc(var(--nav-h) + clamp(12px, 3vh, 32px));
        font-size: clamp(20px, 1.9vw, 30px);
        color: var(--verse);
    }

    .poem span {
        display: block;
        white-space: nowrap;
        opacity: 0;
        animation: fade-up 1s ease forwards;
    }

    /* The second line arrives with the nightlight (see the tour timing in the script) */
    .poem span:nth-child(2) {
        animation-delay: 1.6s;
    }

    .details {
        grid-area: details;
        position: relative;
        z-index: 3;
    }

    .punch {
        align-self: end;
        padding-bottom: clamp(70px, 11vh, 104px);
        font-size: clamp(24px, 2.3vw, 38px);
        font-weight: 600;
        color: var(--gold);
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.9s ease 0.4s, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.4s;
    }

    .is-found .punch {
        opacity: 1;
        transform: none;
    }

    .title {
        margin: 0;
        font-family: var(--font-theme);
        font-weight: 800;
        font-variation-settings: 'SOFT' 100, 'WONK' 0, 'opsz' 144;
        font-size: clamp(52px, 6.2vw, 108px);
        line-height: 0.95;
        letter-spacing: -0.02em;
        color: var(--cream);
    }

    .title-year {
        color: var(--gold);
    }

    .title-kicker {
        display: block;
        margin-bottom: clamp(10px, 1.1vw, 16px);
        font-weight: 600;
        font-variation-settings: 'SOFT' 100, 'WONK' 0, 'opsz' 24;
        font-size: clamp(13px, 1.05vw, 17px);
