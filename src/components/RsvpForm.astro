---
import { event, RSVP_ENDPOINT } from '../data/event';
---
<section class="rsvp-section" id="rsvp">
    <div class="card">
        <p class="eyebrow">RSVP</p>
        <h2 class="heading">Will you be stirring?</h2>
        <p class="lede">{event.date} · {event.time} · {event.location}</p>

        <form class="form" data-rsvp-form data-endpoint={RSVP_ENDPOINT} novalidate>
            <input type="hidden" name="year" value={event.year} />

            <!-- Honeypot: people never see or fill this; bots usually do -->
            <div class="hp" aria-hidden="true">
                <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
            </div>

            <fieldset class="choice">
                <legend class="field-label">Are you coming?</legend>
                <label class="pill">
                    <input type="radio" name="attending" value="yes" checked />
                    <span>Wouldn’t miss it</span>
                </label>
                <label class="pill">
                    <input type="radio" name="attending" value="no" />
                    <span>Can’t make it</span>
                </label>
            </fieldset>

            <label class="field">
                <span class="field-label">Name(s)</span>
                <input type="text" name="name" required maxlength="120" autocomplete="name" placeholder="Who’s coming" />
            </label>

            <label class="field">
                <span class="field-label">Email</span>
                <input type="email" name="email" required maxlength="160" autocomplete="email" placeholder="So we can send reminders" />
            </label>

            <label class="field" data-guests-field>
                <span class="field-label">How many grown-ups?</span>
                <select name="guests">
                    {[1, 2, 3, 4, 5, 6].map((n) => <option value={n} selected={n === 2}>{n}</option>)}
                </select>
            </label>

            <label class="field">
                <span class="field-label">Anything we should know? <em>Optional</em></span>
                <textarea name="note" rows="3" maxlength="500" placeholder="Allergies, plus-ones, pajama spoilers…"></textarea>
            </label>

            <button type="submit" class="submit">Send RSVP</button>
            <p class="status" role="status" aria-live="polite" data-status></p>
        </form>

        <div class="thanks" data-thanks hidden>
            <p class="thanks-title" data-thanks-title>You’re on the list.</p>
            <p class="thanks-body" data-thanks-body>See you in your pajamas on {event.date}.</p>
        </div>
    </div>
</section>

<script>
    const form = document.querySelector<HTMLFormElement>('[data-rsvp-form]');
    const status = document.querySelector<HTMLElement>('[data-status]');
    const thanks = document.querySelector<HTMLElement>('[data-thanks]');
    const guestsField = document.querySelector<HTMLElement>('[data-guests-field]');

    if (form && status && thanks) {
        const endpoint = form.dataset.endpoint ?? '';

        // Only ask for a head count when they're coming
        form.addEventListener('change', () => {
            const coming = (form.elements.namedItem('attending') as RadioNodeList).value === 'yes';
            if (guestsField) guestsField.hidden = !coming;
        });

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            status.textContent = '';

            if (!form.checkValidity()) {
                status.textContent = 'Please add your name and a valid email.';
                form.reportValidity();
                return;
            }
            if (!endpoint) {
                status.textContent = 'RSVPs aren’t open yet. Check back soon!';
                return;
            }

            const data = new FormData(form);
            if (data.get('attending') === 'no') data.set('guests', '0');
            const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
            if (button) {
                button.disabled = true;
                button.textContent = 'Sending…';
            }

            try {
                // Apps Script doesn't send CORS headers for us to read, so this is
                // fire-and-confirm: a network failure throws, anything else landed.
                await fetch(endpoint, {
                    method: 'POST',
                    mode: 'no-cors',
                    body: new URLSearchParams(data as unknown as Record<string, string>),
                });

                if (data.get('attending') === 'no') {
                    thanks.querySelector('[data-thanks-title]')!.textContent = 'We’ll miss you.';
                    thanks.querySelector('[data-thanks-body]')!.textContent = 'Thanks for letting us know. Sleep well.';
                }
                form.hidden = true;
                thanks.hidden = false;
            } catch {
                status.textContent = 'That didn’t go through. Check your connection and try again.';
                if (button) {
                    button.disabled = false;
                    button.textContent = 'Send RSVP';
                }
            }
        });
    }
</script>

<style>
    .rsvp-section {
        position: relative;
        z-index: 1;
        padding: clamp(48px, 8vh, 96px) 20px clamp(80px, 12vh, 140px);
    }

    .card {
        max-width: 620px;
        margin: 0 auto;
        padding: clamp(32px, 5vw, 56px);
        border-radius: 20px;
        background:
            radial-gradient(ellipse 80% 60% at 50% 0%, rgba(212, 168, 83, 0.08), transparent 70%),
            var(--bg-card);
        border: 1px solid rgba(212, 168, 83, 0.14);
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
    }

    .eyebrow {
        font-family: var(--font-body);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 14px;
        text-align: center;
    }

    .heading {
        font-family: var(--font-theme);
        font-weight: 800;
        font-variation-settings: 'SOFT' 100, 'opsz' 96;
        font-size: clamp(32px, 4vw, 46px);
        line-height: 1.05;
        letter-spacing: -0.02em;
        text-align: center;
        color: var(--text-primary);
        margin-bottom: 12px;
    }

    .lede {
        font-family: var(--font-theme);
        font-style: italic;
        font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 36;
        font-size: 17px;
        text-align: center;
        color: var(--text-mid);
        margin-bottom: 36px;
    }

    .form {
        display: grid;
        gap: 22px;
    }

    .form[hidden],
    .field[hidden] {
        display: none;
    }

    .hp {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        overflow: hidden;
    }

    .field {
        display: grid;
        gap: 8px;
    }

    .field-label {
        font-family: var(--font-body);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: var(--text-mid);
    }

    .field-label em {
        font-style: normal;
        letter-spacing: 1px;
        text-transform: none;
        color: var(--text-dim);
        margin-left: 6px;
    }

    input[type='text'],
    input[type='email'],
    select,
    textarea {
        width: 100%;
        padding: 14px 16px;
        border-radius: 10px;
        border: 1px solid rgba(237, 228, 212, 0.12);
        background: rgba(10, 8, 6, 0.6);
        color: var(--text-primary);
        font-family: var(--font-body);
        font-size: 16px;
        font-weight: 300;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    textarea {
        resize: vertical;
        min-height: 96px;
    }

    input::placeholder,
    textarea::placeholder {
        color: var(--text-dim);
    }

    input:focus,
    select:focus,
    textarea:focus {
        outline: none;
        border-color: var(--gold);
        box-shadow: 0 0 0 3px rgba(212, 168, 83, 0.18);
    }

    .choice {
        border: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .choice legend {
        margin-bottom: 10px;
    }

    .pill {
        position: relative;
        cursor: pointer;
    }

    .pill input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .pill span {
        display: inline-block;
        padding: 11px 20px;
        border-radius: 100px;
        border: 1px solid rgba(237, 228, 212, 0.16);
        font-family: var(--font-theme);
        font-style: italic;
        font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 24;
        font-size: 16px;
        color: var(--text-mid);
        transition: all 0.2s ease;
    }

    .pill input:checked + span {
        border-color: var(--gold);
        background: rgba(212, 168, 83, 0.14);
        color: var(--text-primary);
    }

    .pill input:focus-visible + span {
        box-shadow: 0 0 0 3px rgba(212, 168, 83, 0.3);
    }

    .submit {
        margin-top: 6px;
        padding: 16px 28px;
        border: 0;
        border-radius: 100px;
        background: var(--gold);
        color: #1a120b;
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 0.25s ease, opacity 0.25s ease;
    }

    .submit:hover,
    .submit:focus-visible {
        background: #e2bb6c;
    }

    .submit:disabled {
        opacity: 0.6;
        cursor: progress;
    }

    .status {
        min-height: 1.4em;
        font-family: var(--font-body);
        font-size: 14px;
        text-align: center;
        color: #e8a08f;
    }

    .thanks {
        text-align: center;
        padding: 24px 0 8px;
    }

    .thanks-title {
        font-family: var(--font-theme);
        font-weight: 800;
        font-variation-settings: 'SOFT' 100, 'opsz' 72;
        font-size: 30px;
        color: var(--gold);
        margin-bottom: 8px;
    }

    .thanks-body {
        font-family: var(--font-body);
        font-weight: 300;
        font-size: 16px;
        color: var(--text-mid);
    }
</style>
