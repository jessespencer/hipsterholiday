---
// The home page's header: the countdown to the next party, plus a way into
// this year's invite and down to the archive. Set in the invite's type
// (Fraunces title, the countdown as type rather than boxes) so home and the
// invite read as one site.
import CountdownTimer from './CountdownTimer.astro';

interface Props {
    invite?: { href: string; year: number };
}
const { invite } = Astro.props;
---
<div class="countdown-hero" id="countdown-hero">
    <div class="countdown-inner">
        <h1 class="title">
            <span class="kicker">The Spencer Family’s</span>
            Hipster <em class="accent">Holiday{invite && <>{' '}{invite.year}</>}</em>
        </h1>

        <span class="rule" aria-hidden="true"></span>

        <div class="timer">
            <CountdownTimer />
        </div>

        {invite && (
            <nav class="ways" aria-label="Where to next">
                <a href={invite.href} class="way way-main">
                    See the {invite.year} invite
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M2 8h11M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
                <a href="#archive" class="way">
                    The archive
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 2v11M3.5 8.5 8 13l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
            </nav>
        )}
    </div>
</div>

<style>
    .countdown-hero {
        --verse: rgba(237, 228, 212, 0.72);
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 1;
    }

    .countdown-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: calc(var(--nav-h) + 32px) 32px 48px;
        max-width: 1000px;
        width: 100%;
    }

    /* Same title as the invite: kicker in small caps, then the name in heavy soft Fraunces */
    .title {
        margin: 0;
        font-family: var(--font-theme);
        font-weight: 800;
        font-variation-settings: 'SOFT' 100, 'WONK' 0, 'opsz' 144;
        font-size: clamp(56px, 9vw, 132px);
        line-height: 0.95;
        letter-spacing: -0.02em;
        color: var(--text-primary);
        text-wrap: balance;
    }

    .kicker {
        display: block;
        margin-bottom: clamp(14px, 1.4vw, 20px);
        font-weight: 600;
        font-variation-settings: 'SOFT' 100, 'WONK' 0, 'opsz' 24;
        font-size: clamp(13px, 1.1vw, 17px);
        line-height: 1;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--verse);
    }

    /* Like the original home title: "Holiday" (and the year) in a red italic */
    .accent {
        font-style: italic;
        font-weight: 700;
        font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
        color: var(--gold);
        display: block;
        /* The italic leans past its box; give the last figure room */
        padding-right: 0.04em;
    }

    .rule {
        display: block;
        width: 56px;
        height: 1px;
        margin: clamp(32px, 3.4vw, 48px) 0 clamp(24px, 2.6vw, 36px);
        background: var(--gold);
        opacity: 0.55;
    }

    /* The countdown keeps its boxes, with the invite's Fraunces numbers inside */
    .timer :global(.time-value) {
        font-family: var(--font-theme);
        font-weight: 700;
        font-variation-settings: 'SOFT' 100, 'opsz' 96;
        letter-spacing: -0.02em;
        color: var(--text-primary);
    }

    .timer :global(.time-label) {
        font-family: var(--font-theme);
        font-weight: 600;
        font-variation-settings: 'SOFT' 100, 'WONK' 0, 'opsz' 24;
        letter-spacing: 0.2em;
        color: var(--verse);
    }

    .timer :global(.target-date) {
        font-family: var(--font-theme);
        font-weight: 600;
        font-variation-settings: 'SOFT' 100, 'WONK' 0, 'opsz' 24;
        letter-spacing: 0.28em;
    }

    .ways {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: clamp(44px, 5vw, 64px);
    }

    .way {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 24px;
        border-radius: 100px;
        border: 1px solid rgba(237, 228, 212, 0.22);
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: var(--text-primary);
        text-decoration: none;
        transition: border-color 0.25s ease, background 0.25s ease, color 0.25s ease;
    }

    .way:hover,
    .way:focus-visible {
        border-color: rgba(237, 228, 212, 0.5);
        background: rgba(237, 228, 212, 0.06);
    }

    .way-main {
        background: var(--gold);
        border-color: var(--gold);
        color: var(--on-gold);
        font-weight: 600;
    }

    .way-main:hover,
    .way-main:focus-visible {
        background: var(--gold-hover);
        border-color: var(--gold-hover);
    }

    @media (max-width: 600px) {
        .countdown-inner {
            padding: calc(var(--nav-h) + 24px) 20px 40px;
        }

        .title {
            font-size: clamp(44px, 13vw, 64px);
        }


        .ways {
            flex-direction: column;
            align-items: stretch;
            width: 100%;
            max-width: 300px;
        }

        .way {
            justify-content: center;
        }
    }
</style>
