---
// The home page's header: the countdown to the next party, plus a way into
// this year's invite and down to the archive.
import CountdownTimer from './CountdownTimer.astro';

interface Props {
    invite?: { href: string; year: number };
}
const { invite } = Astro.props;
---
<div class="countdown-hero" id="countdown-hero">
    <div class="hero-border-top"></div>

    <div class="countdown-inner">
        <p class="overline">The Spencer Family’s</p>
        <h1 class="brand-title">
            <span class="title-top">Hipster</span>
            <span class="title-bottom">Holiday</span>
        </h1>

        <div class="ornament">
            <span class="orn-line"></span>
            <svg class="orn-star" width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M7 0L8.5 5.5L14 7L8.5 8.5L7 14L5.5 8.5L0 7L5.5 5.5L7 0Z" fill="currentColor"/>
            </svg>
            <span class="orn-line"></span>
        </div>

        <CountdownTimer />

        {invite && (
            <nav class="ways" aria-label="Where to next">
                <a href={invite.href} class="way way-main">
                    See the {invite.year} invite
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M2 8h11M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
                <a href="#archive" class="way">
                    The archive
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 2v11M3.5 8.5 8 13l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
            </nav>
        )}
    </div>

    {!invite && (
        <div class="scroll-cue">
            <div class="scroll-line"></div>
        </div>
    )}
</div>

<style>
    .countdown-hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 1;
    }

    .hero-border-top {
        position: absolute;
        top: 0;
        left: 10%;
        right: 10%;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--gold-dim), transparent);
    }

    .countdown-inner {
        text-align: center;
        padding: 48px 32px;
        max-width: 900px;
        width: 100%;
    }

    .overline {
        font-family: var(--font-body);
        font-weight: 300;
        font-size: 12px;
        letter-spacing: 5px;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 40px;
    }

    .brand-title {
        font-family: var(--font-display);
        font-weight: 300;
        line-height: 0.85;
        margin-bottom: 36px;
    }

    .title-top {
        display: block;
        font-size: clamp(72px, 14vw, 160px);
        letter-spacing: 0.04em;
        color: var(--text-primary);
    }

    .title-bottom {
        display: block;
        font-size: clamp(72px, 14vw, 160px);
        font-style: italic;
        font-weight: 600;
        color: var(--accent);
        margin-top: -0.05em;
    }

    .ornament {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin-bottom: 48px;
    }

    .orn-line {
        display: block;
        width: 80px;
        height: 1px;
        background: var(--gold);
        opacity: 0.3;
    }

    .orn-star {
        color: var(--gold);
        opacity: 0.6;
        flex-shrink: 0;
    }

    .ways {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 56px;
    }

    .way {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 24px;
        border-radius: 100px;
        border: 1px solid rgba(237, 228, 212, 0.22);
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: var(--text-primary);
        text-decoration: none;
        transition: border-color 0.25s ease, background 0.25s ease, color 0.25s ease;
    }

    .way:hover,
    .way:focus-visible {
        border-color: rgba(237, 228, 212, 0.5);
        background: rgba(237, 228, 212, 0.06);
    }

    .way-main {
        background: var(--gold);
        border-color: var(--gold);
        color: var(--on-gold);
        font-weight: 600;
    }

    .way-main:hover,
    .way-main:focus-visible {
        background: var(--gold-hover);
        border-color: var(--gold-hover);
    }

    .scroll-cue {
        position: absolute;
        bottom: 48px;
        left: 50%;
        transform: translateX(-50%);
    }

    .scroll-line {
        width: 1px;
        height: 40px;
        background: linear-gradient(to bottom, var(--gold), transparent);
        opacity: 0.25;
        animation: pulse 2.5s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { opacity: 0.15; }
        50% { opacity: 0.4; }
    }

    @media (max-width: 600px) {
        .countdown-inner {
            padding: 32px 20px;
        }

        .overline {
            font-size: 10px;
            letter-spacing: 4px;
            margin-bottom: 28px;
        }

        .orn-line {
            width: 40px;
        }

        .ways {
            flex-direction: column;
            align-items: stretch;
            max-width: 300px;
            margin: 44px auto 0;
        }

        .way {
            justify-content: center;
        }

        .hero-border-top {
            left: 5%;
            right: 5%;
        }
    }
</style>
