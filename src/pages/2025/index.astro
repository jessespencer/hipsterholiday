---
import TopNav from '../../components/TopNav.astro';
import { ForestParallax } from '../../components/forest/ForestParallax';
---
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hipster Holiday 2025</title>

    <meta property="og:type" content="website">
    <meta property="og:url" content="https://hipsterholiday.com/2025/">
    <meta property="og:title" content="Hipster Holiday 2025">
    <meta property="og:description" content="Join us for a night of Friendsmas bliss! December 12th, 6PM. Stranger Things themed holiday party.">
    <meta property="og:image" content="https://hipsterholiday.com/2025/assets/hh-2025-social.jpg">

    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://hipsterholiday.com/2025/">
    <meta property="twitter:title" content="Hipster Holiday 2025">
    <meta property="twitter:description" content="Join us for a night of Friendsmas bliss! December 12th, 6PM. Stranger Things themed holiday party.">
    <meta property="twitter:image" content="https://hipsterholiday.com/2025/assets/hh-2025-social.jpg">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="image" href="/2025/assets/parallax/family.webp" fetchpriority="high">
    <link rel="preload" as="image" href="/2025/assets/parallax/sky.jpg">
    <!-- Fraunces and Outfit match Base.astro exactly, so the shared nav reuses the same cached font files -->
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700&family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,400..800,0..100,0..1;1,9..144,400..800,0..100,0..1&family=Outfit:wght@200;300;400;500;600&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=VT323&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
    <TopNav />
    <div class="page-wrapper">
        <div class="hero-bg">
            <ForestParallax client:load />
        </div>

        <div class="content-wrapper">
            <div class="header-date">
                <p>FRIDAY, DECEMBER 12TH, 6PM</p>
            </div>

            <div class="main-content">
                <p class="subtitle"><span class="subtitle-full">A SPENCER ORIGINAL SERIES</span><span class="subtitle-mobile">A SPENCER ORIGINAL SERIES</span></p>

                <div class="hero-logo">
                    <img src="/2025/assets/hh-2025-logo.png" alt="Hipster Holiday Logo">
                    <!-- the unlit "L" tube: fading it in makes that letter brown out like loose neon -->
                    <img class="logo-tube-off" src="/2025/assets/hh-2025-logo-l-off.png" alt="" aria-hidden="true">
                </div>

                <section class="details-section" aria-labelledby="details-title">
                    <h2 class="neon-title" id="details-title">
                        <span class="neon-bar" aria-hidden="true"></span>
                        The Details
                        <span class="neon-bar" aria-hidden="true"></span>
                    </h2>

                    <div class="crt">
                        <div class="case-file">
                            <p class="file-label">File 001 &middot; When</p>
                            <h3 class="file-heading">When the portal unofficially opens</h3>
                            <p class="file-date">Friday, December 12th, 2025 at 6:00&nbsp;PM</p>
                        </div>

                        <div class="case-file">
                            <p class="file-label">File 002 &middot; What</p>
                            <h3 class="file-heading">Step into Friendsmas&hellip; Stranger Things edition.</h3>
                            <div class="file-body">
                                <p>Homemade cookies, steaming glühwein, dangerously good food, and games that may accidentally open a tiny portal to the Upside Down.</p>
                                <p>Wear your finest Christmas drip or lean fully into that 80's Hawkins aesthetic—think retro sweaters, mall-rat chic, or "I'm just stopping by to battle a Demogorgon real quick."</p>
                                <p>We're classing it up this year: one gift per person, limit $30. No flea-market relics… unless they're fabulous.</p>
                                <p>Unless your tiny human is still powered by mana's liquid gold, this is a night for the grown-ups to battle Vecna in peace.</p>
                            </div>
                        </div>

                    </div>
                </section>
            </div>
        </div>
    </div>

</body>
</html>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Figtree', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
        background: #010310;
        color: #fff;
        min-height: 100vh;
        overflow-x: hidden;
    }

    .page-wrapper {
        position: relative;
        width: 100%;
        overflow-x: hidden;
    }

    .hero-bg {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 1280px;
        height: auto;
        z-index: 0;
    }

    .content-wrapper {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .header-date {
        padding: 16px 32px;
        margin-top: 0;
    }

    .header-date p {
        font-family: 'Figtree', sans-serif;
        font-weight: 300;
        font-size: 20px;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: #ffffff;
        text-align: center;
        line-height: 1.25;
    }

    .main-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 48px;
        padding: 0 0 120px;
        margin-top: 670px;
        width: 100%;
    }

    .subtitle {
        font-family: 'Figtree', sans-serif;
        font-weight: 300;
        font-size: 20px;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: #ffffff;
        text-align: center;
        line-height: 1.25;
    }

    .subtitle-mobile { display: none; }
    .subtitle-full { display: inline; }

    .hero-logo {
        width: 500px;
        height: 325px;
        mix-blend-mode: lighten;
    }

    .hero-logo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* ---- Neon flicker: a slow buzz across the sign, plus one loose letter ---- */
    .hero-logo {
        position: relative;
        animation: neon-buzz 9s infinite;
    }

    /* sits exactly over the "L" in HOLIDAY (crop box in the logo image, in %) */
    .hero-logo .logo-tube-off {
        position: absolute;
        left: 32.982%;
        top: 41.296%;
        width: 17.632%;
        height: 32.928%;
        object-fit: fill;
        opacity: 0;
        animation: neon-loose 6.5s infinite;
    }

    @keyframes neon-buzz {
        0%, 100% { filter: brightness(1); }
        41% { filter: brightness(1); }
        42% { filter: brightness(0.72); }
        43% { filter: brightness(1.05); }
        44.5% { filter: brightness(0.82); }
        46% { filter: brightness(1); }
        78% { filter: brightness(0.96); }
        79% { filter: brightness(1.04); }
    }

    /* opacity of the unlit tube: 0 = lit, 1 = out */
    @keyframes neon-loose {
        0%, 30%, 37%, 69%, 81%, 100% { opacity: 0; }
        31% { opacity: 0.9; }
        32% { opacity: 0.1; }
        33.5% { opacity: 0.75; }
        35% { opacity: 0; }
        70% { opacity: 1; }
        75% { opacity: 1; }
        76% { opacity: 0.3; }
        77% { opacity: 0.85; }
        78.5% { opacity: 0; }
    }

    .details-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 40px;
        width: 100%;
        max-width: 560px;
    }

    /* ---- Neon section title, framed like the logo ---- */
    .neon-title {
        display: flex;
        align-items: center;
        gap: 18px;
        width: 100%;
        font-family: 'Libre Baskerville', Georgia, serif;
        font-weight: 700;
        font-size: 30px;
        letter-spacing: 3px;
        text-transform: uppercase;
        white-space: nowrap;
        color: transparent;
        -webkit-text-stroke: 1.2px #ff4a3d;
        text-shadow: 0 0 6px rgb(255 50 40 / 0.85), 0 0 18px rgb(220 20 20 / 0.6), 0 0 40px rgb(200 0 0 / 0.35);
    }

    .neon-bar {
        flex: 1;
        height: 3px;
        border-radius: 2px;
        background: #ff5a4a;
        box-shadow: 0 0 6px rgb(255 50 40 / 0.9), 0 0 16px rgb(220 20 20 / 0.6);
    }

    /* ---- VHS / CRT card ---- */
    .crt {
        position: relative;
        width: 100%;
        padding: 44px 36px 48px;
        border-radius: 22px;
        background:
            radial-gradient(ellipse at 50% 40%, #121528 0%, #0a0c18 70%, #06070f 100%);
        border: 1.5px solid rgb(255 70 60 / 0.75);
        box-shadow:
            0 0 0 1px rgb(255 70 60 / 0.15),
            0 0 18px rgb(255 40 30 / 0.35),
            0 0 60px rgb(200 0 0 / 0.18),
            inset 0 0 60px rgb(0 0 0 / 0.75);
        display: flex;
        flex-direction: column;
        gap: 44px;
        overflow: hidden;
        isolation: isolate;
    }

    /* faint scanlines */
    .crt::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 2;
        background: repeating-linear-gradient(to bottom, rgb(255 255 255 / 0.035) 0 1px, transparent 1px 3px);
        mix-blend-mode: screen;
    }
    .case-file {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        text-align: center;
    }

    .file-label {
        font-family: 'VT323', monospace;
        font-size: 20px;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #ff5a4a;
        text-shadow: 0 0 6px rgb(255 60 40 / 0.55);
    }

    .file-heading {
        font-family: 'Libre Baskerville', Georgia, serif;
        font-weight: 700;
        font-size: 21px;
        line-height: 1.35;
        color: #f4ede0;
    }

    .file-date {
        font-family: 'Courier Prime', 'Courier New', monospace;
        font-size: 17px;
        color: rgb(244 237 224 / 0.8);
    }

    .file-body {
        display: flex;
        flex-direction: column;
        gap: 22px;
        margin-top: 8px;
        font-family: 'Courier Prime', 'Courier New', monospace;
        font-size: 16px;
        line-height: 1.6;
        color: rgb(244 237 224 / 0.74);
    }

    /* a tiny bulb between paragraphs */
    .file-body p + p::before {
        content: '';
        display: block;
        width: 7px;
        height: 11px;
        margin: 0 auto 22px;
        border-radius: 50% 50% 45% 45%;
        background: hsl(var(--b, 0) 95% 60%);
        box-shadow: 0 0 10px hsl(var(--b, 0) 95% 55%);
    }
    .file-body p:nth-child(2) { --b: 130; }
    .file-body p:nth-child(3) { --b: 45; }
    .file-body p:nth-child(4) { --b: 200; }


    /* Below this width the date line (about 390px wide, centred) would run into the
       site nav, so the whole page (art and content together) starts under the nav */
    @media (max-width: 1280px) {
        .page-wrapper { padding-top: 64px; }
        .hero-bg { top: 64px; }
    }

    @media (max-width: 1280px) {
        .hero-bg { width: 100%; max-width: 1280px; }
        .hero-logo { max-width: 500px; }
    }

    @media (max-width: 768px) {
        .hero-bg { width: 800px; min-width: 800px; }
        .header-date p, .subtitle { font-size: 16px; letter-spacing: 4px; }
        .main-content { margin-top: 470px; gap: 40px; padding: 0 24px; width: 100%; }
        .hero-logo { width: 100%; max-width: 500px; height: auto; aspect-ratio: 1140 / 741; }
        .hero-logo img { width: 100%; height: 100%; object-fit: contain; }
        .details-section { gap: 32px; }
        .neon-title { font-size: 24px; gap: 12px; }
        .crt { padding: 36px 22px 40px; }
    }

    @media (max-width: 480px) {
        .hero-bg { width: 800px; min-width: 800px; }
        .header-date p { font-size: 16px; letter-spacing: 4px; }
        .subtitle { font-size: 14px; letter-spacing: 4px; }
        .subtitle-full { display: none; }
        .subtitle-mobile { display: inline; }
        .main-content { margin-top: 450px; gap: 24px; padding: 0 24px; }
        .hero-logo { width: 100%; max-width: 500px; height: auto; aspect-ratio: 1140 / 741; }
        .neon-title { font-size: 20px; letter-spacing: 2px; }
        .file-heading { font-size: 19px; }
    }
</style>
