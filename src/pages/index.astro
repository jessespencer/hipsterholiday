---
// Home: the countdown to the next party, a way into this year's invite, and the archive.
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';
import Countdown from '../components/Countdown.astro';
import InviteGallery from '../components/InviteGallery.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { event } from '../data/event';

const invite = `/${event.year}/`;
---
<Base title="Hipster Holiday" accent="red">
    <TopNav />
    <main>
        <Countdown invite={{ href: invite, year: event.year }} />
        <InviteGallery />
    </main>
    <SiteFooter />
</Base>
